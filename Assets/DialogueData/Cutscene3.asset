  m_Script: {fileID: 11500000, guid: 4627fbf1660443846bdcf9abe8e8a6b9, type: 3}
  m_Name: Cutscene3
  m_EditorClassIdentifier: Assembly-CSharp::DialogueObject
  dialogue:
  - "\u041D\u041F\u0421:\n\u0421\u043B\u0438\u0448\u043A\u043E\u043C \u0442\u0438\u0445\u043E
    \u0438\u0434\u0451\u0448\u044C."
  - "\u041D\u041F\u0421:\n\u041E\u0431\u044B\u0447\u043D\u043E \u0441\u044E\u0434\u0430
    \u0432\u0440\u044B\u0432\u0430\u044E\u0442\u0441\u044F...\n\u043A\u0440\u0438\u0447\u0430\u0442...\n\u043B\u043E\u043C\u044F\u0442\u0441\u044F
    \u043D\u0430\u0432\u0435\u0440\u0445.\n"
  - "\u0413\u0413:\n\u041C\u043D\u0435 \u043D\u0435\u043A\u0443\u0434\u0430 \u0441\u043F\u0435\u0448\u0438\u0442\u044C.\n"
  - "\u041D\u041F\u0421:\n\u041E\u0448\u0438\u0431\u0430\u0435\u0448\u044C\u0441\u044F."
  - "*\u041D\u041F\u0421 \u043A\u0438\u0432\u0430\u0435\u0442 \u043D\u0430 \u043B\u0435\u0441\u0442\u043D\u0438\u0446\u0443.*"
  - "\u041D\u041F\u0421:\n\u0422\u0430\u043C \u043D\u0430\u0432\u0435\u0440\u0445\u0443
    \u0432\u0440\u0435\u043C\u044F\n\u0432\u0441\u0435\u0433\u0434\u0430 \u0437\u0430\u043A\u0430\u043D\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F
    \u0431\u044B\u0441\u0442\u0440\u0435\u0435."
  - "\u0413\u0413:\n\u042F \u0440\u0430\u0437\u0431\u0435\u0440\u0443\u0441\u044C."
  - "*\u041D\u041F\u0421 \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442
    \u0430\u043C\u043F\u0443\u043B\u0443.*"
  - "\u041D\u041F\u0421:\n\u0417\u043D\u0430\u0435\u0448\u044C, \u0447\u0442\u043E
    \u043F\u043E\u043C\u043E\u0433\u0430\u0435\u0442\n\xAB\u0440\u0430\u0437\u043E\u0431\u0440\u0430\u0442\u044C\u0441\u044F\xBB?"
  - "\u041D\u041F\u0421:\n\u0425\u0413\u0427.\n\u0413\u043E\u0440\u043C\u043E\u043D
    \u0440\u043E\u0441\u0442\u0430.\n\u0422\u0440\u0435\u043D\u0431\u043E\u043B\u043E\u043D."
  - "*\u041E\u043D \u0441\u043B\u0435\u0433\u043A\u0430 \u0441\u0442\u0443\u0447\u0438\u0442
    \u043F\u043E \u0448\u043F\u0440\u0438\u0446\u0443.*"
  - "\u041D\u041F\u0421:\n\u0411\u044B\u0441\u0442\u0440\u0435\u0435 \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0435\u0448\u044C\u0441\u044F.\n\u0411\u043E\u043B\u044C\u0448\u0435
    \u0432\u044B\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0435\u0448\u044C.\n\u0414\u043E\u043B\u044C\u0448\u0435
    \u043D\u0435 \u043F\u0430\u0434\u0430\u0435\u0448\u044C."
  - "\u0413\u0413:\n\u0418 \u0434\u043E\u043B\u044C\u0448\u0435 \u043D\u0435 \u043F\u043E\u043D\u0438\u043C\u0430\u0435\u0448\u044C,\n\u0447\u0442\u043E
    \u0441 \u0442\u043E\u0431\u043E\u0439 \u043F\u0440\u043E\u0438\u0441\u0445\u043E\u0434\u0438\u0442."
  - "\u041D\u041F\u0421:\n\u041F\u043E\u043D\u0438\u043C\u0430\u043D\u0438\u0435\n\u043D\u0435
    \u0434\u0435\u043B\u0430\u0435\u0442 \u0441\u0438\u043B\u044C\u043D\u0435\u0435."
  - "\u0413\u0413:\n\u0418\u043D\u043E\u0433\u0434\u0430 \u0434\u0435\u043B\u0430\u0435\u0442."
  - "\u041D\u041F\u0421:\n\u0422\u044B \u043D\u0435 \u043F\u043E\u0445\u043E\u0436\n\u043D\u0430
    \u0442\u0435\u0445, \u043A\u0442\u043E \u043F\u0440\u0438\u0445\u043E\u0434\u0438\u043B
    \u0434\u043E \u0442\u0435\u0431\u044F."
  - "\u041D\u041F\u0421:\n\u041E\u043D\u0438 \u0441\u043C\u043E\u0442\u0440\u0435\u043B\u0438
    \u0432\u0432\u0435\u0440\u0445...\n\u043A\u0430\u043A \u043D\u0430 \u043D\u0430\u0433\u0440\u0430\u0434\u0443."
  - "\u0413\u0413:\n\u0410 \u044F?"
  - "\u041D\u041F\u0421:\n\u0422\u044B \u0441\u043C\u043E\u0442\u0440\u0438\u0448\u044C...\n\u043A\u0430\u043A
    \u0431\u0443\u0434\u0442\u043E \u0443\u0436\u0435 \u0432\u0441\u0451 \u0440\u0435\u0448\u0438\u043B."
  - "\u0413\u0413:\n\u0420\u0435\u0448\u0435\u043D\u0438\u044F \u043F\u0440\u0438\u043D\u0438\u043C\u0430\u044E\u0442\u0441\u044F
    \u0440\u0430\u043D\u044C\u0448\u0435."
  - "\u041D\u041F\u0421:\n\u0418 \u0447\u0442\u043E \u0442\u0430\u043C?"
  - "\u041D\u041F\u0421:\n\u041D\u0430\u0432\u0435\u0440\u0445\u0443."
  - "\u0413\u0413:\n\u041E\u0442\u0432\u0435\u0442."
  - "\u041D\u041F\u0421:\n\u041E\u0442\u0432\u0435\u0442\u044B \u043E\u0431\u044B\u0447\u043D\u043E\n\u0440\u0430\u0437\u043E\u0447\u0430\u0440\u043E\u0432\u044B\u0432\u0430\u044E\u0442."
  - "\u0413\u0413:\n\u0422\u043E\u0433\u0434\u0430 \u044D\u0442\u043E \u0431\u0443\u0434\u0435\u0442
    \u0447\u0435\u0441\u0442\u043D\u043E."
  - "\u041D\u041F\u0421:\n\u0425\u043C."
  - "*\u041D\u041F\u0421 \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442 \u0441\u0443\u043C\u043A\u0443\n\u0438
    \u0437\u0430\u043A\u0438\u0434\u044B\u0432\u0430\u0435\u0442 \u0435\u0451 \u043D\u0430
    \u043F\u043B\u0435\u0447\u043E.*"
  - "\u041D\u041F\u0421:\n\u0412\u0441\u0435, \u043A\u0442\u043E \u0448\u0451\u043B
    \u0441\u044E\u0434\u0430...\n\u0445\u043E\u0442\u0435\u043B\u0438 \u0441\u0442\u0430\u0442\u044C
    \u0441\u0438\u043B\u044C\u043D\u0435\u0435."
  - "\u0413\u0413:\n\u0410 \u0442\u044B?"
  - "\u041D\u041F\u0421:\n\u042F \u0443\u0436\u0435 \u0441\u0442\u0430\u043B."
  - "\u041D\u041F\u0421:\n\u0418 \u0432\u0441\u0451 \u0435\u0449\u0451 \u043D\u0435\u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E."
  - "\u0413\u0413:\n\u0422\u043E\u0433\u0434\u0430 \u043F\u043E\u0447\u0435\u043C\u0443
    \u0442\u044B \u0437\u0434\u0435\u0441\u044C?\n\u0410 \u043D\u0435 \u043D\u0430\u0432\u0435\u0440\u0445\u0443?"
  - "*\u041D\u041F\u0421 \u043C\u043E\u043B\u0447\u0438\u0442 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
    \u0441\u0435\u043A\u0443\u043D\u0434.*"
  - "\u041D\u041F\u0421:\n\u041F\u043E\u0442\u043E\u043C\u0443 \u0447\u0442\u043E
    \u0442\u0430\u043C..."
  - "*\u041E\u043D \u0441\u0436\u0438\u043C\u0430\u0435\u0442 \u043A\u0443\u043B\u0430\u043A.*"
  - "\u041D\u041F\u0421:\n...\u043C\u043E\u0436\u0435\u0442 \u043E\u043A\u0430\u0437\u0430\u0442\u044C\u0441\u044F\n\u043A\u0442\u043E-\u0442\u043E
    \u0441\u0438\u043B\u044C\u043D\u0435\u0435."
  - "\u0413\u0413:\n\u0418 \u0442\u044B \u0431\u043E\u0438\u0448\u044C\u0441\u044F?"
  - "\u041D\u041F\u0421:\n\u042F \u043D\u0435 \u043B\u044E\u0431\u043B\u044E \u043F\u0440\u043E\u0438\u0433\u0440\u044B\u0432\u0430\u0442\u044C."
  - "\u0413\u0413:\n\u042F \u0442\u043E\u0436\u0435."
  - "*\u0422\u0438\u0448\u0438\u043D\u0430.*"
  - "\u041D\u041F\u0421:\n\u041D\u043E \u0442\u044B \u0432\u0441\u0451 \u0440\u0430\u0432\u043D\u043E
    \u043F\u043E\u0439\u0434\u0451\u0448\u044C."
  - "\u0413\u0413:\n\u0414\u0430."
  - "\u041D\u041F\u0421:\n\u0414\u0430\u0436\u0435 \u0435\u0441\u043B\u0438 \u0442\u0430\u043C
    \u043A\u043E\u043D\u0435\u0446?"
  - "*\u041D\u041F\u0421 \u043E\u0442\u0445\u043E\u0434\u0438\u0442 \u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u0443,\n\u043E\u0441\u0432\u043E\u0431\u043E\u0436\u0434\u0430\u044F
    \u043F\u0440\u043E\u0445\u043E\u0434.*"
  - "\u041D\u041F\u0421:\n\u0418\u0434\u0438."
  - "*\u041F\u0430\u0443\u0437\u0430.*\n"
  - "\u041D\u041F\u0421:\n\u041F\u0440\u0438\u0447\u0438\u043D\u044B \u0432\u0440\u043E\u0434\u0435
    \u0442\u0432\u043E\u0435\u0439..."
  - "\u041D\u041F\u0421:\n\u0418\u043D\u043E\u0433\u0434\u0430 \u0434\u0430\u044E\u0442
    \u0441\u0438\u043B\u0443...\n\u0441\u0438\u043B\u044C\u043D\u0435\u0435 \u043B\u044E\u0431\u043E\u0439
    \u0445\u0438\u043C\u0438\u0438."
  - "\u0413\u0413:\n\u0418\u043D\u043E\u0433\u0434\u0430."
  - "\u041D\u041F\u0421:\n\u0422\u0440\u0438\u0434\u0446\u0430\u0442\u044C \u044D\u0442\u0430\u0436\u0435\u0439."
  - "\u041D\u041F\u0421:\n\u0421 \u043A\u0430\u0436\u0434\u044B\u043C \u2014\n\u0442\u044F\u0436\u0435\u043B\u0435\u0435
    \u0434\u044B\u0448\u0430\u0442\u044C."
  - "\u041D\u041F\u0421:\n\u0421 \u043A\u0430\u0436\u0434\u044B\u043C \u2014\n\u043C\u0435\u043D\u044C\u0448\u0435
    \u0448\u0430\u043D\u0441\u043E\u0432 \u0432\u0435\u0440\u043D\u0443\u0442\u044C\u0441\u044F."
  - "\u0413\u0413:\n\u042F \u043D\u0435 \u0441\u043E\u0431\u0438\u0440\u0430\u044E\u0441\u044C
    \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0442\u044C\u0441\u044F."
  - "\u0413\u0413:\n\u0410 \u0442\u044B?"
  - "*\u041D\u041F\u0421 \u0441\u0430\u0434\u0438\u0442\u0441\u044F \u043E\u0431\u0440\u0430\u0442\u043D\u043E\n\u0438
    \u0431\u0435\u0440\u0451\u0442 \u0430\u043C\u043F\u0443\u043B\u0443.*"
  - "\u041D\u041F\u0421:\n\u042F...\n"
  - "*\u041E\u043D \u0441\u043C\u043E\u0442\u0440\u0438\u0442 \u043D\u0430 \u043D\u0435\u0451.*"
  - "\u041D\u041F\u0421:\n...\u043F\u043E\u043A\u0430 \u0435\u0449\u0451\n\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u044E\u0441\u044C
    \u0441\u0438\u043B\u044C\u043D\u0435\u0435."
  - "\u0413\u0413:\n\u041D\u0430\u0434\u0435\u044E\u0441\u044C,\n\u0442\u044B \u043D\u0430\u0439\u0434\u0451\u0448\u044C
    \u0437\u0430\u0447\u0435\u043C."
  - "\u041D\u041F\u0421:\n\u0410 \u0442\u044B \u2014\n\u043D\u0430\u0434\u0435\u044E\u0441\u044C,\n\u043D\u0430\u0439\u0434\u0451\u0448\u044C,
    \u0447\u0442\u043E \u0438\u0441\u043A\u0430\u043B."
